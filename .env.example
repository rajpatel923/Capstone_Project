# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fridge_dev

# ── Clerk Auth ─────────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: PEM public key for offline JWT verification (skips JWKS network call)
CLERK_JWT_KEY=

# ── TOTP Encryption ───────────────────────────────────────────────────────────
# Generate once and keep secret:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# ── CTF Range Webhook ─────────────────────────────────────────────────────────
# Any random string; must match what your CTF range sends in X-Webhook-Secret
RANGE_WEBHOOK_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Public URL of the backend as seen from the browser (not the Docker hostname)
NEXT_PUBLIC_API_URL=http://localhost:8000
